{
  "version": "0.1.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "TwitchBSR",
    "id": "twitch-bsr",
    "version": "0.1.0",
    "url": null,
    "additionalData": {
      "overrideSoName": "libtwitch-bsr.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": ["pwsh ./scripts/build.ps1"],
      "copy": ["pwsh ./scripts/copy.ps1"],
      "qmod": ["pwsh ./scripts/build.ps1", "qpm qmod zip"]
    },
    "qmodIncludeDirs": ["./build", "./extern/libs"],
    "qmodIncludeFiles": [],
    "qmodOutput": "TwitchBSR.qmod"
  },
  "dependencies": [
    { "id": "beatsaber-hook", "versionRange": "^6.4.0", "additionalData": {} },
    { "id": "bs-cordl", "versionRange": "^4000.0.0", "additionalData": {} },
    { "id": "custom-types", "versionRange": "^0.18.0", "additionalData": {} },
    { "id": "scotland2", "versionRange": "^0.1.6", "additionalData": { "includeQmod": false } },
    { "id": "bsml", "versionRange": "^0.4.0", "additionalData": {} },
    { "id": "songcore", "versionRange": "^1.1.0", "additionalData": {} },
    { "id": "web-utils", "versionRange": "^0.6.0", "additionalData": {} },
    { "id": "zip", "versionRange": "^1.0.0", "additionalData": {} },
    { "id": "paper2_scotland2", "versionRange": "^4.0.0", "additionalData": {} }
  ]
}
